---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cabinet from '../components/Cabinet.astro';
import { anime, bgm, bgmUser, devices } from '../data/status';
import { songs, songUrl, likedUrl } from '../data/music';
import { asset } from '../data/asset';
import { movies, douban, movieCover } from '../data/movies';
import { shelves, byScore } from '../data/books';
import { feedGroups } from '../data/feeds';
import { poems, quotes } from '../data/excerpts';

const cover = (id: number) => asset(`img/covers/${id}.webp`);

const top = anime.filter((a) => a.score >= 9);
const rest = anime.filter((a) => a.score < 9);
const SHELF_MAX = 11;
const movieShelf = movies.map((m) => ({
  title: m.name,
  score: m.stars * 2, // 仅供排序
  url: douban(m.id),
  img: asset(movieCover(m.id)),
}));
const shelfGroups = [
  { label: '电影', href: asset('movies'), items: movieShelf, showScore: false },
  ...shelves.map(([label, anchor, items]) => ({ label, href: `${asset('bangumi')}#${anchor}`, items, showScore: true })),
];

const pad2 = (n: number) => String(n).padStart(2, '0');
const listCount = movies.length + anime.length + shelves.reduce((n, [, , items]) => n + items.length, 0);
const feedCount = feedGroups.reduce((n, g) => n + g.items.length, 0);
// 展柜设备固定六件(见 Cabinet.astro)
const SECTIONS = [
  { id: 'collection', t: '展柜', en: 'SELECTED WORKS', n: '06' },
  { id: 'list', t: '清单', en: 'CURATED LISTS', n: pad2(listCount) },
  { id: 'music', t: '音乐', en: 'ROTATION & OST', n: pad2(songs.length) },
  { id: 'feeds', t: '订阅', en: 'RSS & CHANNELS', n: pad2(feedCount) },
  { id: 'excerpts', t: '摘抄', en: 'FRAGMENTS & QUOTES', n: pad2(poems.length + quotes.length) },
];
---
<Base title="xihale" description="xihale 的收藏：设备、清单与订阅。">
  <Header
    idle
    brandHref="#top"
    nav={[
      { label: '展柜', href: '#collection' },
      { label: '清单', href: '#list' },
      { label: '音乐', href: '#music' },
      { label: '订阅', href: '#feeds' },
      { label: '摘抄', href: '#excerpts' },
    ]}
  />

  <main id="top" class="home">
    <section class="hero">
      <!-- 星轨:一条连贯的尾迹,穿过节点后沿左边落到画面底 -->
      <svg class="sky" aria-hidden="true">
        <defs>
          <linearGradient id="rail-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="var(--accent)" stop-opacity="0"/>
            <stop offset="0.2" stop-color="var(--accent)" stop-opacity="0.4"/>
            <stop offset="1" stop-color="var(--accent)" stop-opacity="0.82"/>
          </linearGradient>
        </defs>
        <path class="rail-glow" fill="none"/>
        <path class="rail" fill="none" stroke="url(#rail-grad)"/>
      </svg>
      <div class="wrap">
        <div class="who">
          <svg class="face" viewBox="56 68 288 332" aria-hidden="true">
            <g class="halo" fill="none" stroke="currentColor" stroke-linecap="round">
              <circle cx="200" cy="150" r="102" stroke-width="1" stroke-dasharray="3 7" opacity="0.5"/>
              <circle cx="200" cy="150" r="138" stroke-width="1" stroke-dasharray="3 9" opacity="0.3"/>
            </g>
            <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M140 186 C128 130 160 92 200 92 C240 92 272 130 260 186"/>
              <path d="M152 152 Q200 132 248 152" stroke-width="1.5"/>
              <path d="M176 84 l-2 -8 M200 82 v-9 M224 84 l2 -8" stroke-width="1.5" stroke="var(--accent)" opacity="0.7"/>
              <path d="M152 96 l-6 -6 M248 96 l6 -6" stroke-width="1.5"/>
              <path d="M141 204 C142 252 168 292 200 297"/>
              <path d="M259 204 C258 240 246 270 228 288"/>
              <g stroke-width="3">
                <rect x="148" y="192" width="46" height="38" rx="12"/>
                <rect x="206" y="192" width="46" height="38" rx="12"/>
                <path d="M194 203 Q200 199 206 203"/>
                <path d="M148 201 L138 199 M252 201 L262 199"/>
              </g>
              <path d="M152 180 Q170 172 192 177 M208 177 Q230 172 248 180" stroke-width="2.5"/>
              <path d="M164 213 Q171 217 178 213 M222 213 Q229 217 236 213" stroke-width="1.5"/>
              <path d="M201 224 Q199 245 194 252 Q200 256 207 252" stroke-width="1.5"/>
              <path d="M187 276 Q200 280 213 276" stroke-width="2"/>
              <path d="M176 294 V322 M224 294 V322" stroke-width="1.5"/>
              <path d="M176 322 L200 352 L224 322"/>
              <path d="M176 322 L156 340 M224 322 L244 340" stroke-width="1.5"/>
              <path d="M156 340 C110 348 78 366 60 400" stroke-width="1.5"/>
              <path d="M244 340 C290 348 322 366 340 400" stroke-width="1.5"/>
            </g>
          </svg>
          <div class="who-txt">
            <p class="who-name">xihale</p>
            <p class="who-tag">器物、声响与字句的切片</p>
            <nav class="who-links mono" aria-label="站外链接">
              <a href="https://github.com/xihale" target="_blank" rel="noopener">GitHub ↗</a>
              <a href="https://xihale.top" target="_blank" rel="noopener">Blog ↗</a>
              <a href="https://bgm.tv/user/xihale" target="_blank" rel="noopener">Bangumi ↗</a>
              <a href="https://x.com/xihale" target="_blank" rel="noopener">X ↗</a>
            </nav>
          </div>
        </div>
        <nav class="hero-fall" aria-label="页面索引">
          {SECTIONS.map((s, i) => (
            <a
              href={`#${s.id}`}
              class="row"
              style={`--i:${i}; --dx:${['43vw', '29vw', '17.5vw', '8.5vw', '2vw'][i]}`}
            >
              <span class="nd" aria-hidden="true"/>
              <b>{s.t}</b>
              <span class="en mono">{s.en}<i>{s.n}</i></span>
            </a>
          ))}
        </nav>
      </div>
    </section>
    <div class="rail-down" aria-hidden="true"></div>

    <div class="wrap">
      <section class="sec" id="collection">
        <header class="head rv">
          <span class="no mono">01 / 05</span>
          <h2>展柜</h2>
          <span class="en mono">SELECTED WORKS</span>
          <span class="rule" aria-hidden="true"></span>
          <span class="meta mono">{devices.length} 件</span>
        </header>
        <div class="rv"><Cabinet /></div>
      </section>

      <section class="sec" id="list">
        <header class="head rv">
          <span class="no mono">02 / 05</span>
          <h2>清单</h2>
          <span class="en mono">CURATED LISTS</span>
          <span class="rule" aria-hidden="true"></span>
          <span class="meta mono">{listCount} 条</span>
        </header>
        <div class="block rv">
          <div class="ghead">
            <h3 class="sub">番</h3>
            <span class="rule" aria-hidden="true"></span>
            <span class="meta mono">{anime.length} 部</span>
          </div>
          <div class="wall-top">
            {top.map((a) => (
              <a class="fig" href={bgm(a.id)} target="_blank" rel="noopener">
                <img src={cover(a.id)} alt={a.title} loading="lazy" decoding="async" width="360" height="540" />
                <span class="cap"><i class="mono">{a.score}</i><b>{a.title}</b></span>
              </a>
            ))}
          </div>
          <div class="wall">
            {rest.map((a) => (
              <a class="card" href={bgm(a.id)} target="_blank" rel="noopener">
                <span class="pimg"><img src={cover(a.id)} alt={a.title} loading="lazy" decoding="async" width="360" height="540" /></span>
                <span class="pcap">{a.title}</span>
              </a>
            ))}
            <a class="card more" href={bgmUser} target="_blank" rel="noopener">
              <span>更多</span>
            </a>
          </div>
        </div>

        <div class="block rv shelf">
          {shelfGroups.map(({ label, href, items, showScore }) => {
            const sorted = byScore(items);
            const shown = sorted.slice(0, SHELF_MAX);
            return (
              <div>
                <div class="ghead">
                  <h3 class="sub">{label}</h3>
                  <span class="rule" aria-hidden="true"></span>
                  <span class="meta mono">{items.length}</span>
                </div>
                <div class="wall small">
                  {shown.map((x) => (
                    <a class="poster" href={x.url} target="_blank" rel="noopener" title={showScore && x.score ? `${x.title} · ${x.score} 分` : x.title}>
                      <img src={x.img} alt={x.title} loading="lazy" decoding="async" width="360" height="540" />
                      {showScore && x.score > 0 && <span class="score">{x.score}</span>}
                      <span class="tip">{x.title}</span>
                    </a>
                  ))}
                  {sorted.length > SHELF_MAX && (
                    <a class="poster more" href={href}>
                      <span>更多</span>
                    </a>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <section class="sec" id="music">
        <header class="head rv">
          <span class="no mono">03 / 05</span>
          <h2>音乐</h2>
          <span class="en mono">ROTATION &amp; OST</span>
          <span class="rule" aria-hidden="true"></span>
          <span class="meta mono">{songs.length} 首</span>
        </header>
        <div class="tracks rv">
            {songs.map((x) => (
              <a class="track" href={songUrl(x.id)} target="_blank" rel="noopener">
                <img src={asset(`img/music/${x.id}.webp`)} alt={`${x.title} · ${x.artist}`} loading="lazy" decoding="async" width="400" height="400" />
                <span class="t"><b>{x.title}</b><i>{x.artist}</i></span>
              </a>
            ))}
            <a class="track more" href={likedUrl} target="_blank" rel="noopener">
              <span class="t"><b>我喜欢的音乐</b><i>网易云歌单 ↗</i></span>
            </a>
        </div>
      </section>

      <section class="sec" id="feeds">
        <header class="head rv">
          <span class="no mono">04 / 05</span>
          <h2>订阅</h2>
          <span class="en mono">RSS &amp; CHANNELS</span>
          <span class="rule" aria-hidden="true"></span>
          <span class="meta mono">{feedGroups.length > 1 ? `${feedGroups.length} 组 ${feedCount} 条` : `博客 × ${feedCount}`}</span>
        </header>
        {feedGroups.map((grp) => (
          <div class="pgroup rv">
            {feedGroups.length > 1 && <h3 class="gname mono">{grp.title}</h3>}
            <ul class="plist-lite">
              {grp.items.map((x, k) => (
                <li>
                  <a class="row" href={x.url} target="_blank" rel="noopener">
                    <span class="rno mono" aria-hidden="true">{pad2(k + 1)}</span>
                    <span class="rname">{x.name}</span>
                    <span class="rdesc">{x.desc}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>

      <section class="sec" id="excerpts">
        <header class="head rv">
          <span class="no mono">05 / 05</span>
          <h2>摘抄</h2>
          <span class="en mono">FRAGMENTS &amp; QUOTES</span>
          <span class="rule" aria-hidden="true"></span>
          <span class="meta mono">{poems.length + quotes.length} 则</span>
        </header>
        <div class="pgroup rv">
          <div class="ghead">
            <h3 class="sub">诗词</h3>
            <span class="rule" aria-hidden="true"></span>
            <a class="all mono" href={asset('poems')}>更多 ↗</a>
          </div>
          <div class="poems">
            {poems.map((p) => (
              <figure class="poem">
                <div class="ptext">
                  {p.lines.map((l) => <span class="pline">{l}</span>)}
                </div>
                <figcaption class="pby">
                  <b>{p.title}</b>
                  <i class="mono">{p.author}</i>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
        <div class="pgroup rv">
          <div class="ghead">
            <h3 class="sub">句子</h3>
            <span class="rule" aria-hidden="true"></span>
            <a class="all mono" href={asset('quotes')}>更多 ↗</a>
          </div>
          <ul class="quotes">
            {quotes.map((q) => (
              <li class="quote">
                <p class="qtext">{q.text}</p>
                <p class="qfrom mono">—— {q.from}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    </div>
  </main>

  <Footer current="home" />
  <a class="rise" href="#top" aria-label="回到顶部">
    <svg class="rise-mark" viewBox="0 0 16 16" aria-hidden="true">
      <path fill="currentColor" d="M8 .4 9.05 6.95 15.6 8 9.05 9.05 8 15.6 6.95 9.05.4 8 6.95 6.95Z"/>
    </svg>
  </a>

  <script>
    import { initCabinet, initHeroRail } from '../scripts/ui';
    import { initChrome } from '../scripts/chrome';

    initCabinet();
    initHeroRail();
    initChrome();
  </script>
</Base>
