---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Cabinet from '../components/Cabinet.astro';
import { groups } from '../data/projects';
import { anime, bgm, bgmUser } from '../data/status';
import { songs, songUrl, likedUrl } from '../data/music';
import { asset, slug } from '../data/asset';
import { movies, douban, movieCover } from '../data/movies';
import { shelves, byScore } from '../data/books';
import fs from 'node:fs';

const thumb = (url: string) => {
  const f = `img/shots/${slug(url)}.webp`;
  return fs.existsSync(`public/${f}`) ? asset(f) : '';
};
const cover = (id: number) => asset(`img/covers/${id}.webp`);
const pad = (n: number) => String(n).padStart(2, '0');
const used = new Set<string>();
const sym = (n: string) => {
  if (!/^[A-Za-z]/.test(n)) return [...n][0];
  const letters = n.replace(/[^A-Za-z]/g, '');
  const first = letters[0].toUpperCase();
  for (const c of letters.slice(1)) {
    const s = first + c.toLowerCase();
    if (!used.has(s)) { used.add(s); return s; }
  }
  return first;
};
let k = 0;
const tiles = groups.flatMap((g) => g.items.map((it) => ({ ...it, cat: g.title, short: g.short, no: pad(++k), sym: sym(it.name), img: thumb(it.url), host: new URL(it.url).host })));
const total = tiles.length;
const top = anime.filter((a) => a.score >= 9);
const rest = anime.filter((a) => a.score < 9);
const SHELF_MAX = 11;
const movieShelf = movies.map((m) => ({
  title: m.name,
  score: m.stars * 2, // 仅供排序
  url: douban(m.id),
  img: asset(movieCover(m.id)),
}));
const shelfGroups = [
  { label: '电影', href: asset('movies'), items: movieShelf, showScore: false },
  ...shelves.map(([label, anchor, items]) => ({ label, href: `${asset('bangumi')}#${anchor}`, items, showScore: true })),
];
---
<Base title="xihale" description="xihale 的个人主页：项目、设备和清单。">
  <Header
    brandHref="#top"
    nav={[
      { label: '关于', href: '#about' },
      { label: '展柜', href: '#collection' },
      { label: '项目', href: '#projects' },
      { label: '清单', href: '#list' },
      { label: '音乐', href: '#music' },
    ]}
  />

  <main id="top">
    <section class="hero">
      <canvas id="julia" aria-hidden="true"></canvas>
      <div class="wrap">
        <h1><span><b>xihale</b></span></h1>
      </div>
    </section>

    <div class="wrap">
      <section class="sec" id="about">
        <div class="rail rv"><span class="no mono">01</span><h2>关于</h2></div>
        <div class="body">
          <p class="lede rv">想法很多，简简单单。</p>
          <p class="links mono rv">
            <a href="https://github.com/xihale" target="_blank" rel="noopener">GitHub ↗</a>
            <a href="https://xihale.top" target="_blank" rel="noopener">Blog ↗</a>
            <a href="https://bgm.tv/user/xihale" target="_blank" rel="noopener">Bangumi ↗</a>
            <a href="https://x.com/xihale" target="_blank" rel="noopener">X ↗</a>
          </p>
        </div>
      </section>

      <section class="sec" id="collection">
        <div class="rail rv"><span class="no mono">02</span><h2>展柜</h2></div>
        <div class="body rv"><Cabinet /></div>
      </section>

      <section class="sec" id="projects">
        <div class="rail rv">
          <span class="no mono">03</span><h2>项目</h2>
          <ul class="filter">
            <li><button class="on mono" data-cat="*" type="button"><span>全部</span><i>{total}</i></button></li>
            {groups.map((g) => <li><button class="mono" data-cat={g.title} type="button"><span>{g.title}</span><i>{g.items.length}</i></button></li>)}
          </ul>
        </div>
        <div class="body rv">
          <div class="tiles" id="tiles">
            {tiles.map((t) => (
              <a class="tile" href={t.url} target="_blank" rel="noopener"
                data-cat={t.cat} data-name={t.name} data-desc={t.desc} data-host={t.host} data-img={t.img} data-sym={t.sym}>
                <span class="n mono">{t.no}</span>
                <span class="c mono">{t.short}</span>
                <b class="sym">{t.sym}</b>
                <span class="nm">{t.name}</span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="sec" id="list">
        <div class="rail rv"><span class="no mono">04</span><h2>清单</h2></div>
        <div class="body">
          <div class="block rv">
            <h3 class="sub">番</h3>
            <div class="wall-top">
              {top.map((a) => (
                <a class="fig" href={bgm(a.id)} target="_blank" rel="noopener">
                  <img src={cover(a.id)} alt={a.title} loading="lazy" decoding="async" width="360" height="540" />
                  <span class="cap"><b>{a.title}</b></span>
                </a>
              ))}
            </div>
            <div class="wall">
              {rest.map((a) => (
                <a class="poster" href={bgm(a.id)} target="_blank" rel="noopener" title={`${a.title} · ${a.score} 分`}>
                  <img src={cover(a.id)} alt={a.title} loading="lazy" decoding="async" width="360" height="540" />
                  <span class="tip">{a.title}</span>
                </a>
              ))}
              <a class="poster more" href={bgmUser} target="_blank" rel="noopener">
                <span>更多</span>
              </a>
            </div>
          </div>

          <div class="block rv shelf">
            {shelfGroups.map(({ label, href, items, showScore }) => {
              const sorted = byScore(items);
              const shown = sorted.slice(0, SHELF_MAX);
              return (
                <div>
                  <h3 class="sub">{label}</h3>
                  <div class="wall small">
                    {shown.map((x) => (
                      <a class="poster" href={x.url} target="_blank" rel="noopener" title={showScore && x.score ? `${x.title} · ${x.score} 分` : x.title}>
                        <img src={x.img} alt={x.title} loading="lazy" decoding="async" width="360" height="540" />
                        {showScore && x.score > 0 && <span class="score">{x.score}</span>}
                        <span class="tip">{x.title}</span>
                      </a>
                    ))}
                    {sorted.length > SHELF_MAX && (
                      <a class="poster more" href={href}>
                        <span>更多</span>
                      </a>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      </section>

      <section class="sec" id="music">
        <div class="rail rv"><span class="no mono">05</span><h2>音乐</h2></div>
        <div class="body rv">
          <div class="tracks">
            {songs.map((x) => (
              <a class="track" href={songUrl(x.id)} target="_blank" rel="noopener">
                <img src={asset(`img/music/${x.id}.webp`)} alt="" loading="lazy" decoding="async" width="400" height="400" />
                <span class="t"><b>{x.title}</b><i>{x.artist}</i></span>
              </a>
            ))}
            <a class="track more" href={likedUrl} target="_blank" rel="noopener">
              <span class="t"><b>我喜欢的音乐</b><i>网易云歌单 ↗</i></span>
            </a>
          </div>
        </div>
      </section>
    </div>
  </main>

  <footer>
    <div class="wrap foot">
      <p class="mono">xihale · 2026</p>
      <p class="mono links">
        <a href="https://github.com/xihale" target="_blank" rel="noopener">GitHub ↗</a>
        <a href="https://xihale.top" target="_blank" rel="noopener">Blog ↗</a>
        <a href="https://bgm.tv/user/xihale" target="_blank" rel="noopener">Bangumi ↗</a>
        <a href="https://x.com/xihale" target="_blank" rel="noopener">X ↗</a>
        <a href={asset('movies')}>电影 ↗</a>
      </p>
    </div>
  </footer>

  <aside id="peek" aria-hidden="true">
    <div class="pimg"></div>
    <p class="pn"></p>
    <p class="pd"></p>
    <p class="ph mono"></p>
  </aside>

  <script>
    import { initJulia } from '../scripts/julia';
    import { initCabinet, initProjects } from '../scripts/ui';
    import { initChrome } from '../scripts/chrome';

    initJulia(document.getElementById('julia') as HTMLCanvasElement);
    initCabinet();
    initProjects();
    initChrome();
  </script>
</Base>
