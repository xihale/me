---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { asset } from '../../data/asset';
import { quotes } from '../../data/excerpts';

const nav = [
  { label: '首页', href: asset('') },
  { label: '诗词', href: asset('poems') },
];
---
<Base title="句子 · xihale" description="读到的句子。">
  <Header brandHref={asset('')} nav={nav} />

  <main id="top" class="archive">
    <div class="wrap">
      <section class="sec" id="all">
        <header class="head rv">
          <h2>句子</h2>
          <span class="rule" aria-hidden="true"></span>
        </header>
        <ul class="arch-quotes rv">
          {quotes.map((q) => (
            <li class="arch-quote">
              <p class="aq-text">{q.text}</p>
              <p class="aq-from mono">—— {q.from}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </main>

  <Footer current="quotes" />

  <script>
    import { initChrome } from '../../scripts/chrome';
    initChrome();
  </script>
</Base>
