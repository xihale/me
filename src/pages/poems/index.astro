---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { asset } from '../../data/asset';
import { poems } from '../../data/excerpts';

const nav = [
  { label: '首页', href: asset('') },
  { label: '句子', href: asset('quotes') },
];
---
<Base title="诗词 · xihale" description="诗词摘抄。">
  <Header brandHref={asset('')} nav={nav} />

  <main id="top" class="archive">
    <div class="wrap">
      <section class="sec" id="all">
        <header class="head rv">
          <h2>诗词</h2>
          <span class="rule" aria-hidden="true"></span>
        </header>
        <div class="arch-poems rv">
          {poems.map((p) => (
            <article class="arch-poem">
              <header class="ap-head">
                <b>{p.title}</b>
                <i class="mono">{p.author}</i>
              </header>
              <p class="ap-lines">
                {p.lines.map((l, i) => <>{i > 0 && <br />}{l}</>)}
              </p>
            </article>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer current="poems" />

  <script>
    import { initChrome } from '../../scripts/chrome';
    initChrome();
  </script>
</Base>
