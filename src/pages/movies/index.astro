---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { asset } from '../../data/asset';
import { movies, douban, movieCover, byStars } from '../../data/movies';

const nums = ['壹', '贰', '叁'];

const groups = [byStars(5), byStars(4), byStars(3)]
  .filter((list) => list.length)
  .map((list, i) => [nums[i], list] as const);
const unrated = byStars(0);
if (unrated.length) groups.push(['朦', unrated] as const);
const last = movies.reduce((a, b) => (a.date > b.date ? a : b));

const nav = [
  { label: '首页', href: asset('') },
  ...groups.map(([label]) => ({ label, href: `#tier-${label}` })),
];
---
<Base title="电影 · xihale" description={`豆瓣看过的电影 ${movies.length} 部，按分数分组。`}>
  <Header brandHref={asset('')} nav={nav} />

  <main id="top">
    <div class="wrap">
      <section class="sec paged" id="all">
        <div class="rail rv">
          <span class="no mono">豆瓣</span>
          <h2>电影</h2>
          <p class="meta mono">共 {movies.length} 部<br />最近 {last.date}</p>
        </div>
        <div class="body">
          {groups.map(([label, list]) => (
            <div class="group rv" id={`tier-${label}`}>
              <h3 class="sub">{label} <span class="mono dim">{list.length} 部</span></h3>
              <div class="rack">
                {list.map((m) => (
                  <a class="fig poster" href={douban(m.id)} target="_blank" rel="noopener" title={m.name}>
                    <img src={asset(movieCover(m.id))} alt={m.name} loading="lazy" decoding="async" width="270" height="381" />
                    <span class="tip">{m.name}</span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <Footer current="movies" />

  <script>
    import { initChrome } from '../../scripts/chrome';
    initChrome();
  </script>
</Base>
