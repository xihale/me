---
import '@fontsource/noto-serif-sc/latin-300.css';
import '@fontsource/noto-serif-sc/latin-500.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fontCss = (w: 300 | 500) => `${base}/fonts/noto-serif-sc/${w}/result.css`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#f3f2ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d0e0e" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={fontCss(300)} />
    <link rel="stylesheet" href={fontCss(500)} />
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        var pref = localStorage.getItem('theme');
        if (pref !== 'light' && pref !== 'dark') pref = 'auto';
        document.documentElement.dataset.pref = pref;
        var dark = pref === 'dark' || (pref === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
