---
import '@fontsource/noto-serif-sc/latin-300.css';
import '@fontsource/noto-serif-sc/latin-500.css';
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fontCss = (w: 300 | 500) => `${base}/fonts/noto-serif-sc/${w}/result.css`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0b0b0a" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href={fontCss(300)} />
    <link rel="stylesheet" href={fontCss(500)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <div class="night" aria-hidden="true">
      <i class="star a"></i>
      <i class="star b"></i>
      <i class="star c"></i>
      <i class="star d"></i>
      <i class="star e"></i>
      <i class="star f"></i>
      <i class="star g"></i>
      <i class="star h"></i>
      <i class="star i"></i>
      <i class="star j"></i>
      <i class="star k"></i>
      <i class="star l"></i>
      <i class="star m"></i>
      <i class="streak s"></i>
      <i class="streak t"></i>
      <i class="streak u"></i>
      <i class="streak v"></i>
      <i class="streak w"></i>
      <i class="streak x"></i>
      <i class="streak y"></i>
      <i class="streak z"></i>
      <i class="streak aa"></i>
      <i class="streak shoot"></i>
      <i class="streak shoot2"></i>
      <i class="streak shoot3"></i>
      <i class="streak shoot4"></i>
      <i class="streak shoot5"></i>
    </div>
    <slot />
  </body>
</html>
