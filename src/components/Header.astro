---
const { brandHref, nav, idle = false } = Astro.props as {
  brandHref: string;
  nav: { label: string; href: string }[];
  idle?: boolean;
};
---
<header class="bar" data-idle={idle ? '' : undefined}>
  <a class="brand" href={brandHref}>橱窗</a>
  {idle && <span class="bar-index mono" aria-hidden="true">INDEX // 01—05</span>}
  {idle && <span class="bar-scroll mono" aria-hidden="true">SCROLL TO EXPLORE ↓</span>}
  <nav>
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
  </nav>
</header>
