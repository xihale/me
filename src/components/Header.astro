---
const { brandHref, nav } = Astro.props as { brandHref: string; nav: { label: string; href: string }[] };
---
<header class="bar">
  <a class="brand" href={brandHref}>梦橱窗</a>
  <nav>
    {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    <button class="theme" id="theme" aria-label="切换明暗主题" type="button">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
        <path class="moon" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        <g class="sun">
          <circle cx="12" cy="12" r="3.5" />
          <path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4" />
        </g>
        <g class="auto">
          <circle cx="12" cy="12" r="8" />
          <path d="M12 4a8 8 0 0 0 0 16z" fill="currentColor" stroke="none" />
        </g>
      </svg>
    </button>
  </nav>
</header>
